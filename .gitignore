.DS_Store

# tpm-installed tmux plugins (regenerated by src/install-tmux-plugins.sh)
dotfiles/tmux/.tmux/plugins/

# lazygit runtime state (not configuration)
dotfiles/lazygit/Library/Application Support/lazygit/state.yml

# LLVM coverage profiling artifacts
*.profraw

# Workspaces remembered window frames. The plugin writes this file itself, a couple of
# seconds after any window move, so it is one machine's session rather than configuration.
# It was tracked once so layouts could travel, and grew from 41 lines to 166 in twelve days
# of ordinary use, with nothing in it typed by a person and no way to merge two machines.
dotfiles/hammerspoon/.hammerspoon/config/workspaces.json
