#!/bin/bash
set -e

# Ask whether unmodified upstream herdr already does what a carried branch does.
#
#   prove <vanilla-checkout> <branch> <fork-checkout>
#
# Exit 0, upstream has it and the branch can go. Exit 1, still needed. Exit 2, this machine
# cannot answer right now, which is a warning rather than a repository defect.
#
# Rust keeps its unit tests inside the file they test, so a branch's tests cannot be copied
# across the way a language with separate test files allows. Copying src/detect/mod.rs would
# carry the patch along with the test and prove nothing. So the question is asked by a probe
# written against vanilla's own surface, kept beside this script, laid into the tests module
# of the vanilla checkout and run there.

VANILLA="$1"
BRANCH="$2"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROBE="$HERE/prove-on-vanilla.rs"
TARGET="$VANILLA/src/detect/mod.rs"

if [[ -z "$VANILLA" || -z "$BRANCH" ]]; then
    echo "  usage: prove <vanilla-checkout> <branch> <fork-checkout>" >&2
    exit 2
fi

case "$BRANCH" in
    feat/detect-agents-in-descendant-process-groups) ;;
    *)
        echo "  no probe is written for $BRANCH" >&2
        exit 2
        ;;
esac

if [[ ! -f "$TARGET" || ! -f "$PROBE" ]]; then
    echo "  cannot find $TARGET or the probe beside this script" >&2
    exit 2
fi

if ! command -v rustup >/dev/null 2>&1; then
    echo "  rustup is not on PATH, so vanilla cannot be tested" >&2
    exit 2
fi
CARGO="$(rustup which cargo 2>/dev/null || true)"
[[ -n "$CARGO" ]] || { echo "  rustup has no cargo for the default toolchain" >&2; exit 2; }
export PATH="$(dirname "$CARGO"):$PATH"

ZIG_PREFIX="$(brew --prefix zig@0.15 2>/dev/null || true)"
if [[ -z "$ZIG_PREFIX" || ! -x "$ZIG_PREFIX/bin/zig" ]]; then
    echo "  zig@0.15 is not present, so vanilla cannot be built" >&2
    exit 2
fi
export ZIG="$ZIG_PREFIX/bin/zig"

# The probe goes inside the tests module, which is the last thing in the file, so it is laid in
# before the final closing brace. A restructured upstream file is a reason to say nothing
# rather than to guess, since a probe in the wrong scope would not compile and would read as
# upstream still needing the patch.
LAST_LINE="$(tail -n 1 "$TARGET")"
if [[ "$LAST_LINE" != "}" ]]; then
    echo "  upstream's src/detect/mod.rs no longer ends with the tests module, the probe needs rewriting" >&2
    exit 2
fi

python3 - "$TARGET" "$PROBE" <<'PY'
import sys
target, probe = sys.argv[1], sys.argv[2]
lines = open(target).read().split('\n')
while lines and lines[-1] == '':
    lines.pop()
assert lines[-1] == '}'
lines[-1:-1] = [''] + open(probe).read().split('\n')
open(target, 'w').write('\n'.join(lines) + '\n')
PY

echo "  building vanilla upstream and running the probe, this takes a few minutes"
if ( cd "$VANILLA" && cargo test --release --bin herdr mdj_probe_upstream >/dev/null 2>&1 ); then
    exit 0
fi

# A failure here is either upstream still being blind, which is the answer, or a checkout that
# will not build at all, which is not. Telling them apart is worth the extra run, since a
# broken build reported as the patch still being needed is the same wrong answer every time.
if ! ( cd "$VANILLA" && cargo build --release >/dev/null 2>&1 ); then
    echo "  vanilla upstream does not build here, so the question cannot be answered" >&2
    exit 2
fi
exit 1
