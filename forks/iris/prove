#!/bin/bash
set -e

# Ask whether unmodified upstream iris already does what a carried branch does.
#
#   prove <vanilla-checkout> <branch> <fork-checkout>
#
# Exit 0, upstream has it and the branch can go. Exit 1, still needed. Exit 2, this machine
# cannot answer right now, which is a warning rather than a repository defect.
#
# Go keeps its tests in files of their own, so the branch's own tests are the probe and they
# can be laid onto vanilla without the branch's source coming with them. What runs is then
# upstream's behaviour measured against the branch's expectations. Which files those are is
# read out of the branch rather than listed here, so a patch that grows a test needs no edit.

VANILLA="$1"
BRANCH="$2"
FORK="$3"

if [[ -z "$VANILLA" || -z "$BRANCH" || -z "$FORK" ]]; then
    echo "  usage: prove <vanilla-checkout> <branch> <fork-checkout>" >&2
    exit 2
fi

if ! command -v go >/dev/null 2>&1; then
    echo "  go is not on PATH, so vanilla cannot be tested" >&2
    exit 2
fi

ref="origin/$BRANCH"
git -C "$FORK" rev-parse --verify --quiet "$ref" >/dev/null || { echo "  no branch $BRANCH on the fork" >&2; exit 2; }

head="$(git -C "$VANILLA" rev-parse HEAD)"
patch_base="$(git -C "$FORK" merge-base "$head" "$ref" 2>/dev/null || true)"
[[ -n "$patch_base" ]] || { echo "  the branch and this release share no history" >&2; exit 2; }

test_files=()
while IFS= read -r f; do
    [[ -n "$f" ]] && test_files+=("$f")
done < <(git -C "$FORK" diff --name-only --diff-filter=ACMR "$patch_base" "$ref" -- '*_test.go')

if [[ "${#test_files[@]}" -eq 0 ]]; then
    echo "  the branch carries no tests, so there is nothing to prove it with" >&2
    exit 2
fi

names=()
pkgs=()
for f in "${test_files[@]}"; do
    mkdir -p "$VANILLA/$(dirname "$f")"
    git -C "$FORK" show "$ref:$f" > "$VANILLA/$f"
    while IFS= read -r name; do
        [[ -n "$name" ]] && names+=("$name")
    done < <(sed -n 's/^func \(Test[A-Za-z0-9_]*\)(.*/\1/p' "$VANILLA/$f")
    pkgs+=("./$(dirname "$f")")
done

unique=()
while IFS= read -r pkg; do
    [[ -n "$pkg" ]] && unique+=("$pkg")
done < <(printf '%s\n' "${pkgs[@]}" | sort -u)
pattern="^($(printf '%s|' "${names[@]}" | sed 's/|$//'))\$"

out="$(mktemp)"
if ( cd "$VANILLA" && go test -count=1 -run "$pattern" "${unique[@]}" ) >"$out" 2>&1; then
    rm -f "$out"
    exit 0
fi

# Tests that will not compile against vanilla mean nothing of the branch exists there yet,
# which is the patch still being needed rather than a machine that cannot answer.
if grep -qE '\[build failed\]|undefined:|cannot use' "$out"; then
    rm -f "$out"
    exit 1
fi
grep -E '^\s+.*_test\.go:[0-9]+:' "$out" | head -3 | sed 's/^/      /' >&2 || true
rm -f "$out"
exit 1
