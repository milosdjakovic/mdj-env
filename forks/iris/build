#!/bin/bash
set -e

# Build iris from the fork checkout, at whatever commit the caller has already checked out,
# and install it at the destination.
#
#   build <checkout> <destination>
#
# The engine owns the clone, the pin and the reporting. This script owns everything specific to
# iris being a Go program, and it is the only file here that knows that word.

CHECKOUT="$1"
DEST="$2"

if [[ -z "$CHECKOUT" || -z "$DEST" ]]; then
    echo "  usage: build <checkout> <destination>" >&2
    exit 2
fi

if ! command -v go >/dev/null 2>&1; then
    echo "  go is not on PATH. It is declared in forks/iris/DEPENDENCIES and mapped in" >&2
    echo "  DEPENDENCIES.map, so the setup layer is what provides it." >&2
    exit 1
fi

# The version the binary reports carries the release it branched from and the commit built, so
# a binary in hand can be placed without asking git anything.
COMMIT="$(git -C "$CHECKOUT" rev-parse HEAD)"
BASE="$(git -C "$CHECKOUT" describe --tags --abbrev=0 --match 'v[0-9]*' --exclude '*nightly*' 2>/dev/null || echo v0)"
VERSION="${BASE#v}+mdj.${COMMIT:0:7}"

mkdir -p "$(dirname "$DEST")"

echo "  compiling $VERSION"
( cd "$CHECKOUT" && go build -trimpath \
    -ldflags "-s -w -X github.com/versenilvis/iris/root.Version=$VERSION" \
    -o "$DEST" ./cmd/iris )

# The two fixes are the whole reason this fork exists, so prove they are in what was just built
# rather than trusting that the compile succeeded. Stock iris compiles just as cleanly.
echo "  checking both fixes are present"
( cd "$CHECKOUT" && go test ./spec/... ./internal/config/... >/dev/null )

built="$("$DEST" version 2>/dev/null || true)"
if [[ "$built" != "iris $VERSION" ]]; then
    echo "  built binary reports '$built', expected 'iris $VERSION'" >&2
    exit 1
fi
