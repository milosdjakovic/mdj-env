# === Appearance ===
font-family = "MesloLGS Nerd Font Mono"
font-size = 18
# Both theme files are generated from theme/palettes by src/check-theme.sh and named for the
# half they fill rather than for a palette, so this line never changes. Which palette paints
# each half, and whether the machine follows the system or is held to one half, is decided
# in theme/active.toml. Edit a colour there, never in the themes directory.
theme = light:mdj-light,dark:mdj-dark

# === Window settings ===
# window-decoration = false
macos-titlebar-style = hidden
window-title-font-family = "MesloLGS Nerd Font Mono"
background-opacity = 0.95
background-blur = macos-glass-regular
# Coloured cells take the window opacity too, so a program's own backgrounds, herdr's
# selected sidebar row among them, show the glass in their palette colour instead of
# painting a solid slab over it. It changes no colour, only how a coloured cell is blended.
background-opacity-cells = true
cursor-style = block
shell-integration-features = no-cursor
window-save-state = never
window-inherit-working-directory = true
window-padding-y = 8
window-padding-x = 8
window-padding-balance = true

# === Behavior ===
confirm-close-surface = false

# === Keybindings ===
macos-option-as-alt = true

# Delete the previous word
keybind = alt+backspace=text:\x17

# Delete from the cursor to the beginning of the line
keybind = cmd+backspace=text:\x15

# Move the cursor one word to the left
keybind = opt+left=text:\x1b[1;5D
 
# Move the cursor one word to the right
keybind = opt+right=text:\x1b[1;5C


keybind = shift+enter=text:\x1b\r

# Quick terminal
quick-terminal-position = center
quick-terminal-size = 80%,80%
quick-terminal-animation-duration = 0
quick-terminal-screen = mouse
keybind = global:cmd+backquote=unbind

