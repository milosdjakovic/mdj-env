# Ghostty Theme: Aura Soft Dark (Soft Text)
#
# Both axes at once. Soft dark moves the paper to #21202e with ANSI black following to
# #1c1b22, and soft text mutes every accent to the Dark Soft register and drops the
# foreground from #edecee to #bdbdbd. This is the quietest of the four.
#
# Slot 8 is the palette's own #6d6d6d, the same as every file here. It reads 3.1 to 1 on
# this background, the lowest of the four, which is what a variant that spends contrast
# twice over is meant to look like.
#
# The slot mapping is the same reasoning as the other aura files beside this one. Each
# chromatic accent is placed once, at the slot nearest its hue, so purple takes blue, pink
# takes magenta and the actual blue takes cyan. That comes from the palette table in
# packages/color-palettes rather than from any of the thirteen terminal packages, eleven of
# which drop pink and blue entirely.

# Set the background and foreground colors
background = #21202e
foreground = #bdbdbd

# Set the cursor color
cursor-color = #8464c6
cursor-text = #21202e

# Set the selection colors
selection-background = #29263c
selection-foreground = #bdbdbd

# Define the color palette
palette = 0=#1c1b22
palette = 1=#c55858
palette = 2=#54c59f
palette = 3=#c7a06f
palette = 4=#8464c6
palette = 5=#c17ac8
palette = 6=#6cb2c7
palette = 7=#bdbdbd
palette = 8=#6d6d6d
palette = 9=#c55858
palette = 10=#54c59f
palette = 11=#c7a06f
palette = 12=#8464c6
palette = 13=#c17ac8
palette = 14=#6cb2c7
palette = 15=#bdbdbd
