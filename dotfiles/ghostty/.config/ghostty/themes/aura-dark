# Ghostty Theme: Aura
#
# Aura ships no Ghostty package. The repository was searched in full and the word appears
# nowhere, so this is a port, and the thirteen terminal packages it does ship disagree with
# each other badly enough that copying any one of them is a choice rather than a default.
#
# The palette table in packages/color-palettes names six chromatic accents, purple #a277ff
# primary, green #61ffca secondary, orange #ffca85 tertiary, pink #f694ff quaternary, blue
# #82e2ff quinary and red #ff6767 senary. ANSI has six chromatic slots, so each one is
# placed once, at the slot nearest its hue. Purple lands on blue and pink lands on magenta,
# which frees the cyan slot for the actual blue.
#
# That is not an invention. Slots 1 through 7 below are byte identical to the normal
# register of the upstream Termux package, which is the one package of the thirteen that
# reaches all seven accents. Most of the others, Alacritty and Kitty included, repeat
# purple across blue and magenta and repeat green across green and cyan, which leaves pink
# and blue unreachable from a terminal entirely.
#
# Two deliberate departures from Termux. Slot 0 is #110f18, the value eleven of the
# thirteen packages use, rather than the background. And the brights repeat the main
# accents, where Termux fills them with the documented Dark Soft register, which is dimmer
# than the normal one and would make bold text fade rather than stand out.
#
# Slot 8 is no longer one of them. It carried #949494 from 9424044 until the palette was
# read properly, and #949494 is in neither the published palette nor any file Aura ships.
# The palette names exactly one grey, #6d6d6d, and calls it muted. Its job there is
# comments, which is also slot 8's job in a terminal, so the palette answers this slot
# directly and Termux already spells out the same value.

# Set the background and foreground colors
background = #15141b
foreground = #edecee

# Set the cursor color
cursor-color = #a277ff
cursor-text = #15141b

# Set the selection colors
selection-background = #29263c
selection-foreground = #edecee

# Define the color palette
palette = 0=#110f18
palette = 1=#ff6767
palette = 2=#61ffca
palette = 3=#ffca85
palette = 4=#a277ff
palette = 5=#f694ff
palette = 6=#82e2ff
palette = 7=#edecee

# Bright black is the palette's one grey, --muted-color, which Aura uses for comments. It
# reads 3.54 to 1 against the background, low on purpose, because a comment is meant to
# recede behind the code it annotates.
palette = 8=#6d6d6d
palette = 9=#ff6767
palette = 10=#61ffca
palette = 11=#ffca85
palette = 12=#a277ff
palette = 13=#f694ff
palette = 14=#82e2ff
palette = 15=#edecee
