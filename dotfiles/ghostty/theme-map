# Ghostty's keys, each pointing at a role from theme/VOCABULARY. This file knows Ghostty's
# vocabulary, the sixteen palette slots and the six special colours, and the palette knows
# nothing about it. A slot number is Ghostty's idea and lives here for that reason.
#
# Slots 9 to 14 are the bright accents and repeat 1 to 6, which is how Aura's own port does
# it, since Aura publishes one shade of each accent. Slot 10 is what fzf's hl+ reads, so it
# stays the secondary.
palette1  = senary
palette2  = secondary
palette3  = tertiary
palette4  = primary
palette5  = quaternary
palette6  = quinary
palette8  = comment
palette9  = senary
palette10 = secondary
palette11 = tertiary
palette12 = primary
palette13 = quaternary
palette14 = quinary
# Slots 16, 17 and 18 are declared for fzf and are the first three no ANSI name claims.
# Ghostty paints all 256, and nothing under dotfiles names any of them, checked against
# p10k's forty indexes and every colour a script here writes. Slot 17 is the grey of herdr's
# secondary line, which fzf's footer reads, and slot 18 is the quiet rule herdr's borders
# take, which fzf's gutter glyph reads, since no slot among the sixteen holds either neutral
# on both halves. Slot 16 is the bar under the current row and is declared per half below,
# because a bar has to be a tint of the page and every one of the sixteen is claimed by a
# role that differs by half, the page on one and the ink on the other. A theme switch
# repaints all three with everything else and nothing watches anything.
palette17 = overlay
palette18 = dim
background           = background
foreground           = foreground
cursor-color         = primary
cursor-text          = background
selection-background = selection
selection-foreground = foreground

# The neutral slots swap by half, because ANSI black is the page on a dark theme and the
# ink on a light one, and white the other way round. Bright white and plain white are the
# ink on the dark half. On the light half plain white is the faint neutral Aura's port uses
# and bright white sits just off the page.
[dark]
palette0  = background
palette7  = foreground
palette15 = foreground
palette16 = dim

# The bar is a neutral on both halves, asked for by eye against the agents panel. On light it
# is surface, the grey of herdr's focused row. On dark surface is too faint to carry a row, so
# the bar takes dim, the same step off the page as herdr's border there, and the purple of
# highlight was turned down because a purple bar read as an accent rather than a lift.
[light]
palette0  = foreground
palette7  = dim
palette15 = surface
palette16 = surface
