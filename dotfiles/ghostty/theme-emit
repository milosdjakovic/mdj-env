#!/bin/bash
# Ghostty's two theme files, written from the resolved map. This script knows Ghostty's file
# syntax, palette = N=#hex for a slot and key = #hex for everything else, and nothing about
# colour. It is handed one file per half of key TAB hex lines, already resolved by
# src/check-theme.sh, and writes each half into its own theme under .config/ghostty/themes.
#
# The files are named for the half they fill rather than for the palette, mdj-dark and
# mdj-light, so the theme line in the config never changes and a light slot holding a dark
# palette when the mode is held is not a file lying about its own name.
#
# --list prints the files this owns, relative to this directory, which is how the checker
# knows what to snapshot before running it.
set -euo pipefail

OUT_DIR=".config/ghostty/themes"
if [[ "${1:-}" == "--list" ]]; then
    printf '%s\n' "$OUT_DIR/mdj-dark" "$OUT_DIR/mdj-light"
    exit 0
fi

dark="$1"; light="$2"; mode="$3"

write_half() {
    local resolved="$1" out="$2" half="$3"
    mkdir -p "$(dirname "$out")"
    {
        printf '# Generated by theme-emit, do not edit. This is the %s half, written from\n' "$half"
        printf '# theme/palettes through dotfiles/ghostty/theme-map by src/check-theme.sh, mode %s.\n' "$mode"
        printf '# Change a colour in the palette or a role in the map and run the checker.\n'
        # Slots first in numeric order, then the specials in the order the map gives them.
        awk -F'\t' '
            $1 ~ /^palette[0-9]+$/ { n = substr($1, 8) + 0; slot[n] = $2; if (n > max) max = n; next }
            { other[++k] = $1 " = " $2 }
            END {
                for (i = 0; i <= max; i++) if (i in slot) printf("palette = %d=%s\n", i, slot[i])
                for (i = 1; i <= k; i++) print other[i]
            }
        ' "$resolved"
    } >"$out"
}

write_half "$dark"  "$OUT_DIR/mdj-dark"  dark
write_half "$light" "$OUT_DIR/mdj-light" light
