#!/bin/bash
# iris's two per half tables, written from the resolved map into theme.toml in place. This
# script knows iris's file syntax, key = "#hex" under [dark] and [light], and nothing about
# colour. It is handed one file per half of key TAB hex lines, already resolved by
# src/check-theme.sh.
#
# The flat keys above the tables are ANSI slots written by hand, so this owns only the span
# from the [dark] header to the end of the file and copies every byte above it through. It
# refuses when the header is missing or when a [light] header sits above it, since the light
# table would then be written twice and iris would refuse the file.
#
# --list prints the file this owns, relative to this directory.
set -euo pipefail

OUT=".config/iris/theme.toml"
if [[ "${1:-}" == "--list" ]]; then
    printf '%s\n' "$OUT"
    exit 0
fi

dark="$1"; light="$2"; mode="$3"

[[ -f "$OUT" ]] || { printf '%s is missing, and this only rewrites a region inside it\n' "$OUT" >&2; exit 1; }
start="$(grep -n '^\[dark\]$' "$OUT" | cut -d: -f1 | head -n 1)"
light_at="$(grep -n '^\[light\]$' "$OUT" | cut -d: -f1 | head -n 1)"
[[ -n "$start" ]] || { printf '%s has no [dark] header to write from\n' "$OUT" >&2; exit 1; }
if [[ -n "$light_at" && "$light_at" -lt "$start" ]]; then
    printf '%s has [light] above [dark], and the span from [dark] down is what this owns\n' "$OUT" >&2
    exit 1
fi

table() {
    awk -F'\t' '{ printf("%s = \"%s\"\n", $1, $2) }' "$1"
}

tmp="$(mktemp)"
{
    head -n "$((start - 1))" "$OUT"
    printf '[dark]\n'
    printf '# Generated by theme-emit, do not edit these two tables. They are written from\n'
    printf '# theme/palettes through dotfiles/iris/theme-map by src/check-theme.sh, mode %s.\n' "$mode"
    printf '# Change a colour in the palette or a role in the map and run the checker. Everything\n'
    printf '# above the tables is written by hand and the generator copies it through.\n'
    table "$dark"
    printf '\n[light]\n'
    table "$light"
} >"$tmp"
mv "$tmp" "$OUT"
