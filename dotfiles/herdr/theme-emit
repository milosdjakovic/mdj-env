#!/bin/bash
# herdr's two theme tables, written from the resolved map into the config in place. This
# script knows herdr's file syntax, key = "#hex" under [theme.custom.dark] and
# [theme.custom.light], and nothing about colour. It is handed one file per half of key TAB
# hex lines, already resolved by src/check-theme.sh.
#
# herdr has no include, so the tables live inside a config that is otherwise written by
# hand. The region this owns runs from the [theme.custom.dark] header up to the [keys]
# header, and every byte outside it is copied through untouched. Both headers have to be
# present and in that order, and the script refuses rather than guesses when they are not,
# since rewriting the wrong span of a config would be worse than writing nothing.
#
# --list prints the file this owns, relative to this directory, which is how the checker
# knows what to snapshot before running it.
set -euo pipefail

OUT=".config/herdr/config.toml"
if [[ "${1:-}" == "--list" ]]; then
    printf '%s\n' "$OUT"
    exit 0
fi

dark="$1"; light="$2"; mode="$3"

[[ -f "$OUT" ]] || { printf '%s is missing, and this only rewrites a region inside it\n' "$OUT" >&2; exit 1; }
start="$(grep -n '^\[theme\.custom\.dark\]$' "$OUT" | cut -d: -f1 | head -n 1)"
end="$(grep -n '^\[keys\]$' "$OUT" | cut -d: -f1 | head -n 1)"
[[ -n "$start" ]] || { printf '%s has no [theme.custom.dark] header to write from\n' "$OUT" >&2; exit 1; }
[[ -n "$end" ]]   || { printf '%s has no [keys] header to write up to\n' "$OUT" >&2; exit 1; }
[[ "$start" -lt "$end" ]] || { printf '%s has [keys] before [theme.custom.dark], and the region between them is what this owns\n' "$OUT" >&2; exit 1; }

table() {
    awk -F'\t' '{ printf("%s = \"%s\"\n", $1, $2) }' "$1"
}

tmp="$(mktemp)"
{
    head -n "$((start - 1))" "$OUT"
    printf '[theme.custom.dark]\n'
    printf '# Generated by theme-emit, do not edit these two tables. They are written from\n'
    printf '# theme/palettes through dotfiles/herdr/theme-map by src/check-theme.sh, mode %s.\n' "$mode"
    printf '# Change a colour in the palette or a role in the map and run the checker. Everything\n'
    printf '# outside the two tables is written by hand and the generator copies it through.\n'
    table "$dark"
    printf '\n[theme.custom.light]\n'
    table "$light"
    printf '\n'
    tail -n "+$end" "$OUT"
} >"$tmp"
mv "$tmp" "$OUT"
