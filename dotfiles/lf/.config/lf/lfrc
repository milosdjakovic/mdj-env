# ============================================
# SETTINGS
# ============================================
set hidden true
set icons true
set previewer ~/.config/lf/scripts/preview.sh

# ============================================
# COMMANDS
# ============================================
#
# Every interactive command is a ${{ }} shell command, lf's own way to run a program in its
# terminal. lf pauses, the program takes the whole screen, and lf comes back when it exits. So
# nothing here needs a multiplexer, and lf behaves the same in Rex, herdr, tmux or a bare terminal.

# Track previous directory on every cd
cmd on-cd &{{
  if [ -f "/tmp/lf-pwd-$id" ]; then
    cp "/tmp/lf-pwd-$id" "/tmp/lf-oldpwd-$id"
  fi
  pwd > "/tmp/lf-pwd-$id"
}}

# Go back to previous directory (toggle with -)
cmd back &{{
  if [ -f "/tmp/lf-oldpwd-$id" ]; then
    prev=$(cat "/tmp/lf-oldpwd-$id")
    lf -remote "send $id cd \"$prev\""
  fi
}}

# Disable default open so l does nothing on files but still enters directories
cmd open

# Preview file with bat (only text files)
cmd preview ${{
  if [ -d "$f" ]; then
    lf -remote "send $id echo 'Cannot preview a directory'"
    sleep 3 && lf -remote "send $id echo" &
  elif case "$(file --mime-type -Lb "$f")" in text/*|application/json|application/xml|application/javascript) false;; *) true;; esac; then
    lf -remote "send $id echo 'Cannot preview binary file: $(basename "$f")'"
    sleep 3 && lf -remote "send $id echo" &
  else
    bat --paging=always --style=numbers "$f"
  fi
}}

# Open file in nvim
cmd edit ${{
  nvim "$f"
}}

# Copy to the system clipboard. Each runs in the background, so nothing takes the screen, and
# lf says what it copied at the bottom. With files marked, every marked path goes, one per line.
# Find them by name with :copy and tab, or press the keys mapped below.
cmd copy-path &{{
  printf '%s' "$fx" | pbcopy
  n=$(printf '%s\n' "$fx" | wc -l | tr -d ' ')
  [ "$n" -gt 1 ] && what="$n paths" || what="path"
  lf -remote "send $id echo 'Copied $what to clipboard'"
}}

cmd copy-name &{{
  names=$(printf '%s\n' "$fx" | while IFS= read -r item; do basename "$item"; done)
  printf '%s' "$names" | pbcopy
  n=$(printf '%s\n' "$fx" | wc -l | tr -d ' ')
  [ "$n" -gt 1 ] && what="$n names" || what="name"
  lf -remote "send $id echo 'Copied $what to clipboard'"
}}

cmd copy-dir &{{
  printf '%s' "$PWD" | pbcopy
  lf -remote "send $id echo 'Copied folder path to clipboard'"
}}

# Trash with confirmation
cmd trash ${{
  items_file=$(mktemp)
  echo "$fx" > "$items_file"
  ~/.config/lf/scripts/trash-confirm.sh "$items_file"
  if [ $? -eq 0 ]; then
    lf -remote "send $id reload"
    lf -remote "send $id echo 'Moved to trash'"
  fi
  rm -f "$items_file"
}}

# Recursive fzf finder with scope toggling
cmd fzf-find ${{
  tmpfile=$(mktemp)
  ~/.config/lf/scripts/fzf-find.sh all current "$PWD" "$tmpfile"
  result=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile"
  if [ -n "$result" ]; then
    if [ -d "$result" ]; then
      lf -remote "send $id cd \"$result\""
    else
      lf -remote "send $id select \"$result\""
    fi
  fi
}}

# Global fzf finder (starts with global scope)
cmd fzf-find-global ${{
  tmpfile=$(mktemp)
  ~/.config/lf/scripts/fzf-find.sh all global "$PWD" "$tmpfile"
  result=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile"
  if [ -n "$result" ]; then
    if [ -d "$result" ]; then
      lf -remote "send $id cd \"$result\""
    else
      lf -remote "send $id select \"$result\""
    fi
  fi
}}

# Show keybindings cheat sheet
cmd help ${{
  ~/.config/lf/scripts/help-menu.sh "$id"
}}

# ============================================
# KEY BINDINGS
# ============================================

# Tab on the : command line shows every matching command as a menu, shift tab goes back.
cmap <tab> cmd-menu-complete
cmap <backtab> cmd-menu-complete-back

map i preview            # Preview file with bat
map o edit               # Open in nvim
# c alone does nothing, it starts the copy keys below.
map c
map cp copy-path         # Copy path to clipboard
map cn copy-name         # Copy name to clipboard
map cd copy-dir          # Copy current folder path to clipboard
map D trash              # Trash selected items
# Browse tagged files, navigate to selected
cmd tag-browser ${{
  tmpfile=$(mktemp)
  ~/.config/lf/scripts/tag-browser.sh current "$PWD" "$tmpfile"
  result=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile"
  if [ -n "$result" ]; then
    if [ -d "$result" ]; then
      lf -remote "send $id cd \"$result\""
    else
      lf -remote "send $id select \"$result\""
    fi
  fi
}}

# Global tag browser (starts with all tags)
cmd tag-browser-global ${{
  tmpfile=$(mktemp)
  ~/.config/lf/scripts/tag-browser.sh all "$PWD" "$tmpfile"
  result=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile"
  if [ -n "$result" ]; then
    if [ -d "$result" ]; then
      lf -remote "send $id cd \"$result\""
    else
      lf -remote "send $id select \"$result\""
    fi
  fi
}}

map F fzf-find           # Find files in current dir
map <a-f> fzf-find-global # Find files globally
map T tag-browser        # Browse tags in current dir
map <a-t> tag-browser-global # Browse all tags
cmd clear-all &{{
  lf -remote "send $id clear"
  lf -remote "send $id unselect"
}}
map U clear-all          # Clear selections and cut/copy marks
map <esc> quit           # Quit lf
map - back               # Previous directory
map ? help               # Show keybindings

# Trigger on-cd on startup to track initial directory
on-cd
