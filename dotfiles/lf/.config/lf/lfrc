# ============================================
# SETTINGS
# ============================================
set hidden true
set icons true
set previewer ~/.config/lf/scripts/preview.sh

# ============================================
# COMMANDS
# ============================================

# Track previous directory on every cd
cmd on-cd &{{
  if [ -f "/tmp/lf-pwd-$id" ]; then
    cp "/tmp/lf-pwd-$id" "/tmp/lf-oldpwd-$id"
  fi
  pwd > "/tmp/lf-pwd-$id"
}}

# Go back to previous directory (toggle with -)
cmd back &{{
  if [ -f "/tmp/lf-oldpwd-$id" ]; then
    prev=$(cat "/tmp/lf-oldpwd-$id")
    lf -remote "send $id cd \"$prev\""
  fi
}}

# Disable default open so l does nothing on files but still enters directories
cmd open

# Preview file with bat in a popup (only text files)
cmd preview &{{
  if [ -d "$f" ]; then
    lf -remote "send $id echo 'Cannot preview a directory'"
    sleep 3 && lf -remote "send $id echo" &
  elif case "$(file --mime-type -Lb "$f")" in text/*|application/json|application/xml|application/javascript) false;; *) true;; esac; then
    lf -remote "send $id echo 'Cannot preview binary file: $(basename "$f")'"
    sleep 3 && lf -remote "send $id echo" &
  else
    tmux display-popup -w 85% -h 85% -E "bat --paging=always --style=numbers \"$f\""
  fi
}}

# Open file in nvim in a popup
cmd edit-popup &{{
  tmux display-popup -w 85% -h 85% -E "nvim \"$f\""
}}

# Copy menu in a popup
cmd copy-menu &{{
  tmpfile=$(mktemp)
  paths_file=$(mktemp)
  echo "$fx" > "$paths_file"
  count=$(echo "$fx" | wc -l | tr -d ' ')
  tmux display-popup -w 24 -h 6 -E "~/.config/lf/scripts/copy-menu.sh $count \"$paths_file\" \"$tmpfile\""
  choice=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile" "$paths_file"
  case "$choice" in
    path) lf -remote "send $id echo 'Copied path to clipboard'";;
    name) lf -remote "send $id echo 'Copied name to clipboard'";;
  esac
}}

# Trash with confirmation popup
cmd trash &{{
  items_file=$(mktemp)
  echo "$fx" > "$items_file"
  tmux display-popup -w 70% -h 50% -E "~/.config/lf/scripts/trash-confirm.sh \"$items_file\""
  if [ $? -eq 0 ]; then
    lf -remote "send $id reload"
    lf -remote "send $id echo 'Moved to trash'"
  fi
  rm -f "$items_file"
}}

# Recursive fzf finder with scope toggling in a popup
cmd fzf-find &{{
  tmpfile=$(mktemp)
  tmux display-popup -w 80% -h 70% -E "~/.config/lf/scripts/fzf-find.sh all current \"$PWD\" \"$tmpfile\""
  result=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile"
  if [ -n "$result" ]; then
    if [ -d "$result" ]; then
      lf -remote "send $id cd \"$result\""
    else
      lf -remote "send $id select \"$result\""
    fi
  fi
}}

# Global fzf finder (starts with global scope)
cmd fzf-find-global &{{
  tmpfile=$(mktemp)
  tmux display-popup -w 80% -h 70% -E "~/.config/lf/scripts/fzf-find.sh all global \"$PWD\" \"$tmpfile\""
  result=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile"
  if [ -n "$result" ]; then
    if [ -d "$result" ]; then
      lf -remote "send $id cd \"$result\""
    else
      lf -remote "send $id select \"$result\""
    fi
  fi
}}

# Show keybindings cheat sheet in a popup
cmd help &{{
  tmux display-popup -w 60% -h 50% -E "~/.config/lf/scripts/help-menu.sh \"$id\""
}}

# ============================================
# KEY BINDINGS
# ============================================

map i preview            # Preview file with bat
map o edit-popup         # Open in nvim
map c copy-menu          # Copy to clipboard
map D trash              # Trash selected items
# Browse tagged files in a popup, navigate to selected
cmd tag-browser &{{
  tmpfile=$(mktemp)
  tmux display-popup -w 80% -h 60% -E "~/.config/lf/scripts/tag-browser.sh current \"$PWD\" \"$tmpfile\""
  result=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile"
  if [ -n "$result" ]; then
    if [ -d "$result" ]; then
      lf -remote "send $id cd \"$result\""
    else
      lf -remote "send $id select \"$result\""
    fi
  fi
}}

# Global tag browser (starts with all tags)
cmd tag-browser-global &{{
  tmpfile=$(mktemp)
  tmux display-popup -w 80% -h 60% -E "~/.config/lf/scripts/tag-browser.sh all \"$PWD\" \"$tmpfile\""
  result=$(cat "$tmpfile" 2>/dev/null)
  rm -f "$tmpfile"
  if [ -n "$result" ]; then
    if [ -d "$result" ]; then
      lf -remote "send $id cd \"$result\""
    else
      lf -remote "send $id select \"$result\""
    fi
  fi
}}

map F fzf-find           # Find files in current dir
map <a-f> fzf-find-global # Find files globally
map T tag-browser        # Browse tags in current dir
map <a-t> tag-browser-global # Browse all tags
cmd clear-all &{{
  lf -remote "send $id clear"
  lf -remote "send $id unselect"
}}
map U clear-all          # Clear selections and cut/copy marks
map <esc> quit           # Quit lf
map - back               # Previous directory
map ? help               # Show keybindings

# Trigger on-cd on startup to track initial directory
on-cd
