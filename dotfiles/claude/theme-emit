#!/bin/bash
# Claude Code's two custom theme files, written from the resolved map. This script knows the
# theme JSON shape, name, base and an overrides object of token to #rrggbb, and nothing about
# colour. It is handed one file per half of key TAB hex lines, already resolved by
# src/check-theme.sh, and writes each half into ~/.claude/themes through the stow package.
#
# The files are named for the half they fill, aura-dark and aura-light, picked with /theme as
# custom:aura-dark or custom:aura-light. --list prints the files this owns.
set -euo pipefail

OUT_DIR=".claude/themes"
if [[ "${1:-}" == "--list" ]]; then
    printf '%s\n' "$OUT_DIR/aura-dark.json" "$OUT_DIR/aura-light.json"
    exit 0
fi

dark="$1"; light="$2"; mode="$3"

write_half() {
    local resolved="$1" out="$2" half="$3" label="$4"
    mkdir -p "$(dirname "$out")"
    awk -F'\t' -v half="$half" -v label="$label" -v mode="$mode" '
        BEGIN {
            printf("{\n  \"name\": \"%s\",\n  \"base\": \"%s\",\n", label, half)
            printf("  \"_generated\": \"Generated by theme-emit, do not edit. Mode %s, from theme/palettes through dotfiles/claude/theme-map by src/check-theme.sh.\",\n", mode)
            printf("  \"overrides\": {")
        }
        { printf("%s\n    \"%s\": \"%s\"", (n++ ? "," : ""), $1, $2) }
        END { printf("\n  }\n}\n") }
    ' "$resolved" >"$out"
}

write_half "$dark"  "$OUT_DIR/aura-dark.json"  dark  "Aura Dark"
write_half "$light" "$OUT_DIR/aura-light.json" light "Aura Light"
