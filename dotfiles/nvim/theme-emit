#!/bin/bash
# Neovim's palette module, written from the resolved map. This script knows the shape
# lua/aura/palette.lua has to have, a table per half and a current() that picks by
# 'background', and nothing about colour. It is handed one file per half of key TAB hex
# lines, already resolved by src/check-theme.sh.
#
# --list prints the file this owns, relative to this directory.
set -euo pipefail

OUT=".config/nvim/lua/aura/palette.lua"
if [[ "${1:-}" == "--list" ]]; then
    printf '%s\n' "$OUT"
    exit 0
fi

dark="$1"; light="$2"; mode="$3"

table() {
    awk -F'\t' '{ printf("    %-12s = \"%s\",\n", $1, $2) }' "$1"
}

{
    cat <<HEADER
-- Generated by theme-emit, do not edit. Written from theme/palettes through
-- dotfiles/nvim/theme-map by src/check-theme.sh, mode $mode. Change a colour in the palette
-- or a role in the map and run the checker.
--
-- Aura's Neovim package defines 357 highlight groups across three files and every one of
-- them resolves to one of ten slots, so a half is ten values rather than 357 overrides. The
-- slot names are semantic, white is the ink and black is the page, so they invert without
-- renaming. gray is Aura's one published grey, the comment colour, deliberately quiet.
-- surface and overlay are not package slots, they are ours, for the lualine theme and for
-- chrome, and the map says which roles they take.
local M = {
  dark = {
HEADER
    table "$dark"
    printf '  },\n  light = {\n'
    table "$light"
    cat <<'FOOTER'
  },
}

-- One place answers which half is live, so the colorscheme, the statusline and anything
-- added later cannot disagree about it.
function M.current()
  return M[vim.o.background == "light" and "light" or "dark"]
end

return M
FOOTER
} >"$OUT"
