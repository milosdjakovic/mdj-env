Workspace.terminalCursorBlinkIntervalMilliseconds | int    | 500
Workspace.terminalCursorBlinkUsesCustomInterval  | bool   | false
Workspace.terminalCursorStyle                    | string | block
Workspace.terminalCursorStyleForced              | bool   | false
