# Rex's own preferences, as key | type | value, applied by src/setup-rex.sh.
#
# Generated by `src/setup-rex.sh --capture` from what Rex stores on the machine it ran on, and
# replaced whole by each capture, so change a setting in Rex's Settings window and capture again
# rather than editing this by hand. Rex stores a setting only while it differs from its default,
# so this file is exactly what was changed from Rex's defaults, and a setting put back to its
# default leaves the file at the next capture.
#
# Never captured are state Rex keeps as it runs, such as window frames and the collapsed sidebar,
# the two theme slots, which the step points at the imported Ghostty pair itself, and Remote
# Control, which lets local programs drive the app and is the person's call on each machine.

Workspace.activePaneBorderColor                  | string | blue
Workspace.activePaneBorderTransition             | string | fade
Workspace.animationStyle                         | string | snappy
Workspace.appIconVisibility                      | string | dockOnly
Workspace.focusFollowsMouse                      | bool   | false
Workspace.inactivePaneFadeMode                   | string | both
Workspace.interfaceStyle                         | string | blendTheme
Workspace.paneDensity                            | string | comfortable
Workspace.shellIconTheme                         | string | default
Workspace.showsActivePaneBorder                  | bool   | true
Workspace.showsPaneHeaders                       | bool   | false
Workspace.sidebarPosition                        | string | left
Workspace.sidebarShowsActivity                   | bool   | false
Workspace.sidebarWidth                           | float  | 205
