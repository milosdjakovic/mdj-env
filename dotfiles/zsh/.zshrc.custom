# oh-my-zsh setup
export ZSH="$HOME/.oh-my-zsh"
plugins=(git fzf-tab zsh-autosuggestions fast-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# fzf-tab config (use tmux popup only when inside tmux)
if [[ -n "$TMUX" ]]; then
  zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
fi

# carapace is the completion dictionary, roughly a thousand commands with flag and value
# descriptions that zsh's own completion mostly lacks, aws and gcloud among them. It only
# supplies candidates, fzf-tab above still draws them, and it registers completion functions
# so it has to come after oh-my-zsh has run compinit. The format line labels each group the
# way carapace's own zsh setup does. It replaces zsh's completion for every command it knows,
# git included, and decisions/shell-autocomplete.md says why it is here instead of iris.
if command -v carapace >/dev/null 2>&1; then
  zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
  source <(carapace _carapace)
fi

# Aliases
alias cd='z'
alias ls='eza'
alias cat='bat'
alias rm='rm -iv'

# Editor
export EDITOR=nvim

# fzf's options live in one file that fzf rereads at every launch, so the string is written
# once for this shell, for tmux and for herdr's popups, and a change reaches a picker inside a
# server without restarting it. The file carries the reasons for every colour. The export is
# guarded on the file being readable, because fzf treats a file it cannot open as a hard
# error, exit 2 with no output, rather than as an absent default. The variable is unset first,
# because fzf applies the file and then the variable, so a string inherited from a server or a
# shell older than this file would silently win over it, which is exactly what happened on the
# day the string moved.
unset FZF_DEFAULT_OPTS
[[ -r "$HOME/.config/fzf/fzfrc" ]] && export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/fzfrc"


# Tool initializers
eval "$(atuin init zsh)"
eval "$(zoxide init zsh)"
source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
# Guarded, unlike the three above it, because fnm is deliberately not in the Brewfile. It is
# a node version switcher and a machine that writes no node has no use for one, so a default
# install does not get it and this line has to survive its absence. Unguarded it printed
# command not found before every prompt on any machine without it, which is how it was found.
command -v fnm >/dev/null 2>&1 && eval "$(fnm env --use-on-cd --version-file-strategy=recursive)"

# ctrl+r goes back to atuin, which fzf had been taking by accident. atuin binds ^r during
# its init above, fzf's key-bindings.zsh is sourced after it and binds ^r to its own history
# widget, so the later file silently won and atuin's search was unreachable. The two are not
# equivalent. fzf greps the plain text of .zsh_history, atuin queries the database that is
# actually recording every command, with filters for session, directory and host, and with
# exit codes and durations attached. These two lines mirror atuin's own bindings exactly.
#
# fzf keeps ^T and alt+c, which put a file or a directory on the line and duplicate nothing.
bindkey -M emacs '^r' atuin-search
bindkey -M viins '^r' atuin-search-viins
