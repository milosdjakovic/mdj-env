# oh-my-zsh setup
export ZSH="$HOME/.oh-my-zsh"
plugins=(git fzf-tab zsh-autosuggestions fast-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# fzf-tab config (use tmux popup only when inside tmux)
if [[ -n "$TMUX" ]]; then
  zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
fi

# Aliases
alias cd='z'
alias ls='eza'
alias cat='bat'
alias rm='rm -iv'

# Editor
export EDITOR=nvim

# fzf colors via ANSI references so they track the terminal palette (aura).
# fzf's defaults reach into xterm-256 spec indices (108, 151, ...) which sit
# outside the 16-color range that themes paint, so matches and prompts render
# in the standard cube colors instead of aura. Mapping to 0-15 routes them
# through ghostty's palette so anything you re-theme later carries over.
export FZF_DEFAULT_OPTS='
  --color=fg:-1,bg:-1,fg+:-1,bg+:-1
  --color=hl:2,hl+:10
  --color=prompt:2,pointer:2,marker:3,spinner:3
  --color=info:#949494,header:#949494,border:#949494
  --color=separator:#949494,scrollbar:#949494,gutter:#949494
'

# Tool initializers
eval "$(atuin init zsh)"
eval "$(zoxide init zsh)"
source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
