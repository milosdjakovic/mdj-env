#!/bin/bash
set -euo pipefail

# Collect this module's dependency declarations into its single upward facing manifest.
# The layer above reads only the generated DEPENDENCIES file and never looks inside this
# module, so that layer stays ignorant of how this one is organised and this one stays free
# to reorganise.
#
# A leaf declaration is five fields, name | kind | locator | policy | reason. The consumer
# column is not written by hand, it is stamped here from where the declaration sits, so a
# file cannot mislabel itself and a rename cannot leave a stale owner behind.
#
# A declaration sits beside whatever knows the tool. A file called <name>.dependencies
# declares the needs of its sibling <name>, whatever that sibling is, so lf.dependencies
# beside explorer/lf.sh is stamped explorer/lf.sh and .tmux.conf.dependencies is stamped
# .tmux.conf. That rule is what lets a swappable adapter carry its own tool, which is the
# whole point here, since the explorer and the VPN provider are both meant to be replaced
# without editing anything outside their own file.
#
# A declaration beside this script rather than beside a file is a need of the module as a
# whole, such as the multiplexer itself, and is stamped with the module name. It is named
# dependencies-module, not dependencies, because this filesystem is case insensitive and a
# file called dependencies here would be the same file as the generated DEPENDENCIES.
#
# Nothing here knows how a tool is installed. That mapping lives one layer up, keyed by the
# name column. Run this after adding or changing a declaration, and the reconciler above runs
# it too so a stale manifest cannot be committed.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODULE="$(basename "$SCRIPT_DIR")"
OUT="$SCRIPT_DIR/DEPENDENCIES"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

{
    echo "# What this module needs on the machine. Generated by dependencies-collect,"
    echo "# do not edit. Each line is name | kind | locator | policy | consumer | reason."
    echo "#"
    echo "# This file is the whole contract with the layer above. It names tools and never"
    echo "# names how to install one, because that mapping belongs to the layer that owns"
    echo "# package management. The consumer column names the file that declared the line,"
    echo "# so to change one, edit the declaration beside that file and run this again."
} >"$tmp"

# Refuse to read the output as an input. On a case insensitive filesystem a declaration
# named badly could be the manifest itself, and that mistake would silently re-stamp every
# consumer column instead of failing.
is_output() {
    [[ -e "$1" && -e "$OUT" ]] || return 1
    [[ "$(stat -f '%i' "$1")" == "$(stat -f '%i' "$OUT")" ]]
}

# The file a declaration speaks for. Stripping .dependencies names it, and the shell scripts
# here carry an extension the declaration does not repeat, so lf.dependencies speaks for
# lf.sh while .tmux.conf.dependencies speaks for .tmux.conf. Trying the bare name first keeps
# a file that already carries its own suffix working without a special case. Prints nothing
# when neither exists, which the caller treats as a stale declaration.
#
# Finding nothing is reported as empty output rather than a non-zero status, because under
# set -e a failing status here would kill the script inside the command substitution that
# calls it, and the caller's own error message would never be reached.
sibling_of() {
    local stem="${1%.dependencies}" candidate
    for candidate in "$stem" "$stem.sh"; do
        if [[ -e "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 0
}

# Who owns a declaration, derived from where it sits, reported relative to the module so it
# reads the way a person refers to these files. The scripts directory is dropped from the
# front because every script lives there and repeating it would say nothing.
owner_of() {
    local rel="${1#"$SCRIPT_DIR"/}"
    printf '%s\n' "${rel#.tmux/scripts/}"
}

declarations=()
[[ -f "$SCRIPT_DIR/dependencies-module" ]] && declarations+=("$SCRIPT_DIR/dependencies-module")
while IFS= read -r found; do
    if is_output "$found"; then
        echo "dependencies-collect: refusing to read $found, it is the output file" >&2
        exit 1
    fi
    declarations+=("$found")
done < <(find "$SCRIPT_DIR" -type f -name '*.dependencies' | sort)

# A declaration whose sibling is gone is a rename that left a stale file behind, and the
# manifest would keep advertising a tool no file here still wants. Fail rather than emit it.
found=0
for decl in "${declarations[@]}"; do
    if [[ "$(basename "$decl")" == "dependencies-module" ]]; then
        consumer="$MODULE"
    else
        sibling="$(sibling_of "$decl")"
        if [[ -z "$sibling" ]]; then
            echo "dependencies-collect: ${decl#"$SCRIPT_DIR"/} speaks for a file that is gone, remove it or restore the file" >&2
            exit 1
        fi
        consumer="$(owner_of "$sibling")"
    fi
    while IFS= read -r line; do
        # Skip blanks and comments, the leaf file documents itself for whoever edits it.
        trimmed="${line#"${line%%[![:space:]]*}"}"
        [[ -z "$trimmed" || "${trimmed:0:1}" == "#" ]] && continue
        IFS='|' read -r name kind locator policy reason <<<"$trimmed"
        trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; echo "${s%"${s##*[![:space:]]}"}"; }
        printf '%s | %s | %s | %s | %s | %s\n' \
            "$(trim "$name")" "$(trim "$kind")" "$(trim "$locator")" \
            "$(trim "$policy")" "$consumer" "$(trim "${reason:-}")"
        found=$((found + 1))
    done <"$decl"
done >>"$tmp"

mv "$tmp" "$OUT"
trap - EXIT

echo "dependencies-collect: wrote $found declaration(s) to ${OUT#"$(dirname "$SCRIPT_DIR")"/}"
