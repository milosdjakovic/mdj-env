{
  "kind": "chooser.geometry",
  "about": "Where a chooser stands on a screen, lib/chooser/providers/default/geometry.lua resolve, which Olm.app ports to place its list exactly where the swift chooser places it. A case is a screen frame in Hammerspoon's space, y measured down from the top of the primary screen, an optional previewPaneWidth, true, a number or absent, and layout fields laid over the file's layout. The rectangles expected were recorded from the Lua answer on 2026-11-08 and the Lua runner checks them on every dry run, so they are what the code answers rather than a rule written by hand.",
  "layout": { "baseH": 57, "bottomBarH": 0, "gap": 14, "iconGap": 10, "iconSize": 33, "marginX": 14, "marginY": 14, "minVPad": 60, "padX": 10, "paneMaxW": 480, "peek": 0.3, "rowCount": 9, "rowH": 47, "topFrac": 0.06, "width": 480 },
  "cases": [
    { "name": "a laptop screen, no preview pane", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 },
      "expect": { "canvas": { "x": 516, "y": 85, "w": 480, "h": 508.1 }, "field": { "x": 530, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 530, "y": 142, "w": 452, "h": 451.1 }, "previewPane": null,
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a large screen", "screen": { "x": 0, "y": 25, "w": 2560, "h": 1415 },
      "expect": { "canvas": { "x": 1040, "y": 109, "w": 480, "h": 508.1 }, "field": { "x": 1054, "y": 109, "w": 452, "h": 57 },
        "list": { "x": 1054, "y": 166, "w": 452, "h": 451.1 }, "previewPane": null,
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a screen to the left of the primary", "screen": { "x": -1920, "y": 0, "w": 1920, "h": 1080 },
      "expect": { "canvas": { "x": -1200, "y": 64, "w": 480, "h": 508.1 }, "field": { "x": -1186, "y": 64, "w": 452, "h": 57 },
        "list": { "x": -1186, "y": 121, "w": 452, "h": 451.1 }, "previewPane": null,
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a screen above the primary", "screen": { "x": 200, "y": -1440, "w": 2560, "h": 1440 },
      "expect": { "canvas": { "x": 1240, "y": -1354, "w": 480, "h": 508.1 }, "field": { "x": 1254, "y": -1354, "w": 452, "h": 57 },
        "list": { "x": 1254, "y": -1297, "w": 452, "h": 451.1 }, "previewPane": null,
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a short screen trims the rows", "screen": { "x": 0, "y": 0, "w": 1280, "h": 600 },
      "expect": { "canvas": { "x": 400, "y": 60, "w": 480, "h": 461.1 }, "field": { "x": 414, "y": 60, "w": 452, "h": 57 },
        "list": { "x": 414, "y": 117, "w": 452, "h": 404.1 }, "previewPane": null,
        "bottomBar": null, "rowCount": 8, "viewRows": 8.3 } },
    { "name": "a screen too short for any row", "screen": { "x": 0, "y": 0, "w": 800, "h": 200 },
      "expect": { "canvas": { "x": 160, "y": 60, "w": 480, "h": 71 }, "field": { "x": 174, "y": 60, "w": 452, "h": 57 },
        "list": { "x": 174, "y": 117, "w": 452, "h": 14 }, "previewPane": null,
        "bottomBar": null, "rowCount": 0, "viewRows": 0 } },
    { "name": "a preview pane as wide as the list", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 }, "previewPaneWidth": true,
      "expect": { "canvas": { "x": 269, "y": 85, "w": 480, "h": 508.1 }, "field": { "x": 283, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 283, "y": 142, "w": 452, "h": 451.1 }, "previewPane": { "x": 763, "y": 85, "w": 480, "h": 508.1 },
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a preview pane narrower than the list", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 }, "previewPaneWidth": 300,
      "expect": { "canvas": { "x": 359, "y": 85, "w": 480, "h": 508.1 }, "field": { "x": 373, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 373, "y": 142, "w": 452, "h": 451.1 }, "previewPane": { "x": 853, "y": 85, "w": 300, "h": 508.1 },
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a preview pane wider than paneMaxW is capped", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 }, "previewPaneWidth": 900,
      "expect": { "canvas": { "x": 269, "y": 85, "w": 480, "h": 508.1 }, "field": { "x": 283, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 283, "y": 142, "w": 452, "h": 451.1 }, "previewPane": { "x": 763, "y": 85, "w": 480, "h": 508.1 },
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a zero preview pane is none", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 }, "previewPaneWidth": 0,
      "expect": { "canvas": { "x": 516, "y": 85, "w": 480, "h": 508.1 }, "field": { "x": 530, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 530, "y": 142, "w": 452, "h": 451.1 }, "previewPane": null,
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a bottom bar under the list", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 }, "layout": { "bottomBarH": 46 },
      "expect": { "canvas": { "x": 516, "y": 85, "w": 480, "h": 554.1 }, "field": { "x": 530, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 530, "y": 142, "w": 452, "h": 451.1 }, "previewPane": null,
        "bottomBar": { "x": 516, "y": 593.1, "w": 480, "h": 46 }, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a bottom bar spanning the preview pane", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 }, "previewPaneWidth": true, "layout": { "bottomBarH": 46, "bottomBarSpan": true, "gap": 0 },
      "expect": { "canvas": { "x": 276, "y": 85, "w": 480, "h": 554.1 }, "field": { "x": 290, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 290, "y": 142, "w": 452, "h": 451.1 }, "previewPane": { "x": 756, "y": 85, "w": 480, "h": 554.1, "under": 46 },
        "bottomBar": { "x": 276, "y": 593.1, "w": 960, "h": 46 }, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a spanning bar with no pane spans the list alone", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 }, "layout": { "bottomBarH": 46, "bottomBarSpan": true },
      "expect": { "canvas": { "x": 516, "y": 85, "w": 480, "h": 554.1 }, "field": { "x": 530, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 530, "y": 142, "w": 452, "h": 451.1 }, "previewPane": null,
        "bottomBar": { "x": 516, "y": 593.1, "w": 480, "h": 46 }, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "one row takes no peek", "screen": { "x": 0, "y": 25, "w": 1512, "h": 957 }, "layout": { "rowCount": 1 },
      "expect": { "canvas": { "x": 516, "y": 85, "w": 480, "h": 118 }, "field": { "x": 530, "y": 85, "w": 452, "h": 57 },
        "list": { "x": 530, "y": 142, "w": 452, "h": 61 }, "previewPane": null,
        "bottomBar": null, "rowCount": 1, "viewRows": 1 } },
    { "name": "an odd screen width centres on a floor", "screen": { "x": 0, "y": 0, "w": 1511, "h": 900 }, "previewPaneWidth": 301,
      "expect": { "canvas": { "x": 358, "y": 60, "w": 480, "h": 508.1 }, "field": { "x": 372, "y": 60, "w": 452, "h": 57 },
        "list": { "x": 372, "y": 117, "w": 452, "h": 451.1 }, "previewPane": { "x": 852, "y": 60, "w": 301, "h": 508.1 },
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } },
    { "name": "a top fraction past the bottom pad is clamped", "screen": { "x": 0, "y": 0, "w": 1440, "h": 900 }, "layout": { "topFrac": 0.9 },
      "expect": { "canvas": { "x": 480, "y": 331.9, "w": 480, "h": 508.1 }, "field": { "x": 494, "y": 331.9, "w": 452, "h": 57 },
        "list": { "x": 494, "y": 388.9, "w": 452, "h": 451.1 }, "previewPane": null,
        "bottomBar": null, "rowCount": 9, "viewRows": 9.3 } }
  ]
}
