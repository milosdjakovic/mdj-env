#!/bin/bash
# The Hammerspoon theme file for the palette, written from the resolved map. This script
# knows the shape of a theme under .hammerspoon/config/themes, a [dark] and a [light] section
# of key = "#rrggbb" lines, and nothing about colour. It is handed one file per half of
# key TAB hex lines, already resolved by src/check-theme.sh.
#
# --list prints the file this owns, relative to this directory.
set -euo pipefail

OUT=".hammerspoon/config/themes/aura.toml"
if [[ "${1:-}" == "--list" ]]; then
    printf '%s\n' "$OUT"
    exit 0
fi

dark="$1"; light="$2"; mode="$3"

section() {
    awk -F'\t' '{ printf("%-10s = \"%s\"\n", $1, $2) }' "$1"
}

{
    cat <<HEADER
# Generated by theme-emit, do not edit. Written from theme/palettes through
# dotfiles/hammerspoon/theme-map by src/check-theme.sh, mode $mode. Change a colour in the
# palette or a role in the map and run the checker.
#
# This is the Aura theme for Olm, the second file beside default.toml, and the switcher on the
# OLM settings page lists it by its file name.

[dark]
HEADER
    section "$dark"
    printf '\n[light]\n'
    section "$light"
} >"$OUT"
