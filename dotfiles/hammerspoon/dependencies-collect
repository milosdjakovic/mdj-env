#!/bin/bash
set -euo pipefail

# Collect every plugin's dependency declaration into this module's single upward facing
# manifest. This is the Hammerspoon module's half of the contract with the layer above,
# which reads only the generated DEPENDENCIES file and never looks inside a spoon, so the
# top layer stays ignorant of spoons and this module stays free to organise itself.
#
# A plugin declares its tools in its own manifest.lua, under needs.tools, which is also the
# one source the running config reads. So this script does not parse those declarations
# itself, it finds the manifests and hands them to a Lua interpreter, which reads them
# exactly rather than guessing at their shape. Reading Lua needs Lua, and how this module
# produces its manifest is this module's own business, so the tool is declared like any other
# and the layer above still reads only the generated file.
#
# A declaration beside this script rather than inside a plugin is a need of the module
# itself, such as the application every plugin runs inside, and is stamped with the module
# name. It is written by hand in the same pipe separated form, five fields, name, kind,
# locator, policy, and reason, since one file at a module root does not drift the way a
# roster of plugins would. It is named dependencies-module, not dependencies, because this
# filesystem is case insensitive and a file called dependencies here would be the same file
# as the generated DEPENDENCIES.
#
# Nothing here knows how a tool is installed unless the declaration itself says so, and then
# this only carries that answer upward. Run it after adding or changing a declaration, and
# the reconciler above runs it too so a stale manifest cannot be committed.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPOON_DIR="$SCRIPT_DIR/.hammerspoon/Spoons/Olm.spoon"
OUT="$SCRIPT_DIR/DEPENDENCIES"
READER="$SCRIPT_DIR/dependencies-collect.lua"

if [[ ! -d "$SPOON_DIR" ]]; then
    echo "dependencies-collect: no Olm.spoon at $SPOON_DIR" >&2
    exit 1
fi
if [[ ! -f "$READER" ]]; then
    echo "dependencies-collect: no reader beside this script at $READER" >&2
    exit 1
fi
# Named and not installed, which is the rule every other declaration in this repository
# follows. lua is declared in this module's own manifest and the map one layer up says where
# it comes from, so the answer to this message lives in one place rather than in this text.
#
# Exit 2, not 1, and the difference is the whole contract with the reconciler above. Two means
# this cannot run on THIS machine, which is a machine fact and a warning up there. Anything else
# nonzero means the declarations themselves are wrong, which is a repository defect and identical
# everywhere, so it is an error. Without that split a missing tool on one laptop reads as a broken
# repository, which is exactly the confusion the two severities exist to prevent.
if ! command -v lua >/dev/null 2>&1; then
    echo "dependencies-collect: lua is not on PATH, and reading a manifest needs it." >&2
    echo "  It is declared in this module's DEPENDENCIES, so ./src/check-dependencies.sh" >&2
    echo "  names where it comes from and setup.sh puts it there." >&2
    exit 2
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

{
    echo "# What this module needs from outside itself. Generated by dependencies-collect,"
    echo "# do not edit. Each line is name | kind | locator | policy | consumer | reason,"
    echo "# and then origin and origin detail, which are empty for a tool that states no"
    echo "# origin of its own and is answered by DEPENDENCIES.map instead."
    echo "#"
    echo "# This file is the whole contract with the layer above. The consumer column names"
    echo "# the plugin that declared the line, or the plugin and the unit inside it where the"
    echo "# declaration says which one wanted the tool, so to change a line, edit needs.tools"
    echo "# in that plugin's manifest.lua and run this again."
} >"$tmp"

# The module's own declaration leads, then every plugin's, so the output does not churn in
# git across machines or filesystems.
same_file_as_output() {
    [[ -e "$1" && -e "$OUT" ]] || return 1
    [[ "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")" \
       == "$(cd "$(dirname "$OUT")" && pwd -P)/$(basename "$OUT")" ]] && return 0
    # Different names can still be one file here, so compare inodes as well.
    [[ "$(stat -f '%i' "$1")" == "$(stat -f '%i' "$OUT")" ]]
}

module_decl="$SCRIPT_DIR/dependencies-module"
if [[ -f "$module_decl" ]]; then
    if same_file_as_output "$module_decl"; then
        echo "dependencies-collect: refusing to read $module_decl, it is the output file" >&2
        exit 1
    fi
    consumer="$(basename "$SCRIPT_DIR")"
    trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; echo "${s%"${s##*[![:space:]]}"}"; }
    while IFS= read -r line; do
        # Skip blanks and comments, the leaf file documents itself for whoever edits it.
        trimmed="${line#"${line%%[![:space:]]*}"}"
        [[ -z "$trimmed" || "${trimmed:0:1}" == "#" ]] && continue
        IFS='|' read -r name kind locator policy reason <<<"$trimmed"
        # Six fields out of five, with the consumer stamped in. Nothing at this level states
        # its own origin, so the line stops at the reason the same way a generated one does.
        printf '%s | %s | %s | %s | %s | %s\n' \
            "$(trim "$name")" "$(trim "$kind")" "$(trim "$locator")" \
            "$(trim "$policy")" "$consumer" "$(trim "${reason:-}")"
    done <"$module_decl" >>"$tmp"
fi

# Sorted so the output is stable whatever order the filesystem hands the manifests back in.
manifests=()
while IFS= read -r found; do
    manifests+=("$found")
done < <(find "$SPOON_DIR/plugins" "$SPOON_DIR/host" "$SPOON_DIR/root" \
    -type f -name manifest.lua 2>/dev/null | sort)

if [[ ${#manifests[@]} -gt 0 ]]; then
    lua "$READER" "${manifests[@]}" >>"$tmp"
fi

mv "$tmp" "$OUT"
trap - EXIT

count="$(grep -cvE '^[[:space:]]*(#|$)' "$OUT" || true)"
echo "dependencies-collect: wrote $count declaration(s) to ${OUT#"$(dirname "$SCRIPT_DIR")"/}"
