#!/bin/bash
# The Herdr app's two theme files, written from the resolved map. This script knows the app's
# JSON theme shape, background, foreground, selection, cursor, an ansi array of sixteen, and a
# colors object, and nothing about colour. It is handed one file per half of key TAB hex
# lines, already resolved by src/check-theme.sh, and a dotted key is one inside colors.
#
# Generated by theme-emit. The JSON files carry no banner, because Herdr reads them with a
# strict schema that refuses any field it does not know, found on 2026-11-08 when a
# _generated field made it reject the whole layout. JSON has no comment, so src/check-theme.sh
# knows these files are generated by this script listing them, and the warning lives here and
# in this package's AGENTS.md.
#
# The files are named for the half they fill, mdj-dark and mdj-light, so settings.json's
# theme line never changes, the same reason Ghostty's are.
#
# --list prints the files this owns, relative to this directory.
set -euo pipefail

OUT_DIR=".config/herdr-app/themes"
OSC_OUT=".config/herdr-app/terminal-colors.zsh"
if [[ "${1:-}" == "--list" ]]; then
    printf '%s\n' "$OUT_DIR/mdj-dark.json" "$OUT_DIR/mdj-light.json" "$OSC_OUT"
    exit 0
fi

dark="$1"; light="$2"

write_half() {
    local resolved="$1" out="$2"
    mkdir -p "$(dirname "$out")"
    awk -F'\t' '
        $2 == "none" { printf("%s asks for none, and a Herdr theme has no transparent colour\n", $1) > "/dev/stderr"; bad = 1; next }
        $1 ~ /^ansi[0-9]+$/ { ansi[substr($1, 5) + 0] = $2; next }
        $1 ~ /^slot[0-9]+$/ { next }
        $1 ~ /^colors\./    { k = substr($1, 8); ckey[++nc] = k; cval[k] = $2; next }
        { top[$1] = $2 }
        END {
            if (bad) exit 1
            for (i = 0; i < 16; i++) if (!(i in ansi)) { printf("ansi%d is not in the map\n", i) > "/dev/stderr"; exit 1 }
            split("background foreground selection cursor", req, " ")
            for (i = 1; i <= 4; i++) if (!(req[i] in top)) { printf("%s is not in the map\n", req[i]) > "/dev/stderr"; exit 1 }
            print "{"
            for (i = 1; i <= 4; i++) printf("  \"%s\": \"%s\",\n", req[i], top[req[i]])
            print "  \"ansi\": ["
            for (r = 0; r < 2; r++) {
                line = "    "
                for (i = r * 8; i < r * 8 + 8; i++) line = line "\"" ansi[i] "\"" (i < 15 ? ", " : "")
                sub(/ $/, "", line); print line
            }
            print "  ],"
            print "  \"colors\": {"
            for (i = 1; i <= nc; i++) printf("    \"%s\": \"%s\"%s\n", ckey[i], cval[ckey[i]], (i < nc ? "," : ""))
            print "  }"
            print "}"
        }
    ' "$resolved" >"$out.tmp"
    mv "$out.tmp" "$out"
}

write_half "$dark"  "$OUT_DIR/mdj-dark.json"
write_half "$light" "$OUT_DIR/mdj-light.json"

# The terminal half again, as the escape sequences a pane sends to its own terminal. Herdr's
# core answers a colour query from its own defaults rather than from the app's theme, a dark
# grey page whatever the half, and holds only sixteen slots, so Claude Code and Neovim chose the
# dark half on the light page and the statusline grey came out navy. Setting every colour in the
# pane, the twenty slots, the ink, the page and the cursor, makes the core answer what Ghostty
# answers. All of them are set together so a pane that has not yet caught up after a switch
# stays wholly on one half instead of ink from one on a page from the other.
# dotfiles/herdr-app/AGENTS.md has why, and dotfiles/zsh/.zshrc.custom sends it.
osc_half() {
    awk -F'\t' '
        function rgb(h) { return "rgb:" substr(h, 2, 2) "/" substr(h, 4, 2) "/" substr(h, 6, 2) }
        $1 ~ /^ansi[0-9]+$/ { slot[substr($1, 5) + 0] = $2; next }
        $1 ~ /^slot[0-9]+$/ { slot[substr($1, 5) + 0] = $2; next }
        $1 == "foreground" { fg = $2 } $1 == "background" { bg = $2 } $1 == "cursor" { cur = $2 }
        END {
            for (i = 0; i < 20; i++) {
                if (!(i in slot)) { printf("slot %d is not in the map\n", i) > "/dev/stderr"; exit 1 }
                printf("\\e]4;%d;%s\\e\\\\", i, rgb(slot[i]))
            }
            printf("\\e]10;%s\\e\\\\\\e]11;%s\\e\\\\\\e]12;%s\\e\\\\", rgb(fg), rgb(bg), rgb(cur))
        }
    ' "$1"
}

{
    printf '# Generated by theme-emit, do not edit. Every colour of a terminal, both halves, written from\n'
    printf '# theme/palettes through dotfiles/herdr-app/theme-map by src/check-theme.sh, mode %s.\n' "$3"
    printf '# dotfiles/zsh/.zshrc.custom sends the half macOS is on to a Herdr app pane.\n'
    printf 'typeset -gA mdj_herdr_osc\n'
    printf "mdj_herdr_osc[dark]=\$'%s'\n" "$(osc_half "$dark")"
    printf "mdj_herdr_osc[light]=\$'%s'\n" "$(osc_half "$light")"
} >"$OSC_OUT.tmp"
mv "$OSC_OUT.tmp" "$OSC_OUT"
