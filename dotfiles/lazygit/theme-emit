#!/bin/bash
# lazygit's two theme overlays, written from the resolved map. This script knows lazygit's
# config syntax, a gui.theme key holding a list of one colour, and nothing about colour. It is
# handed one file per half of key TAB hex lines, already resolved by src/check-theme.sh, and
# writes each half beside lazygit's own config.yml, where stow links them. A launcher lists the
# half macOS is on after config.yml in LG_CONFIG_FILE, the later file winning, so lazygit's own
# config stays the base and the overlay adds only colour.
#
# --list prints the files this owns, relative to this directory, which is how the checker
# knows what to snapshot before running it.
set -euo pipefail

OUT_DIR="Library/Application Support/lazygit"
if [[ "${1:-}" == "--list" ]]; then
    printf '%s\n' "$OUT_DIR/mdj-dark.yml" "$OUT_DIR/mdj-light.yml"
    exit 0
fi

dark="$1"; light="$2"; mode="$3"

write_half() {
    local resolved="$1" out="$2" half="$3"
    mkdir -p "$(dirname "$out")"
    {
        printf '# Generated by theme-emit, do not edit. This is the %s half, written from\n' "$half"
        printf '# theme/palettes through dotfiles/lazygit/theme-map by src/check-theme.sh, mode %s.\n' "$mode"
        printf '# Change a colour in the palette or a role in the map and run the checker.\n'
        printf 'gui:\n  theme:\n'
        awk -F'\t' '{ printf("    %s:\n      - \"%s\"\n", $1, $2) }' "$resolved"
    } >"$out"
}

write_half "$dark"  "$OUT_DIR/mdj-dark.yml"  dark
write_half "$light" "$OUT_DIR/mdj-light.yml" light
